{"topic":"estimate_order_output","kind":"structure","description":"Shape of estimate_order response — pre-flight feasibility check with fee and margin projection.","fields":[{"path":"feasible","description":"True if the order would be accepted. False when pre-trade risk, permissions, or margin blocks it.","type":"boolean"},{"path":"isExitOrder","description":"True if the order reduces/closes the existing position rather than increasing exposure.","type":"boolean"},{"path":"symbol","description":"Echo of input.","type":"string"},{"path":"action","description":"Echo of input.","type":"string"},{"path":"quantity","description":"Echo of input.","type":"integer"},{"path":"currency","description":"Account currency used for all monetary fields.","type":"string"},{"path":"netLiqValue","description":"Current netLiq (pre-trade reference).","type":"number"},{"path":"currentUsedMargin","description":"Used margin before the hypothetical order.","type":"number"},{"path":"projectedUsedMargin","description":"Used margin if the order fills fully.","type":"number"},{"path":"excess","description":"Available margin after the order (netLiq − projectedUsedMargin).","type":"number"},{"path":"fees","description":"Estimated total cost if the order fills fully, broken down by fee type.","type":"object"},{"path":"fees.commission","description":"Broker commission.","type":"number"},{"path":"fees.brokerageFee","description":"Broker fee (excluding commission).","type":"number"},{"path":"fees.exchangeFee","description":"Exchange fee.","type":"number"},{"path":"fees.clearingFee","description":"Clearing fee.","type":"number"},{"path":"fees.nfaFee","description":"NFA regulatory fee.","type":"number"},{"path":"fees.ipFee","description":"IP / connectivity fee.","type":"number"},{"path":"fees.orderRoutingFee","description":"Order routing fee.","type":"number"},{"path":"fees.currency","description":"Fee currency (matches account currency).","type":"string"},{"path":"error","description":"Present only when feasible=false.","type":"object"},{"path":"error.reason","description":"Rejection code — RejectedReason enum member, pre-trade block code, or 'InternalError'.","type":"string"},{"path":"error.message","description":"Human-readable explanation (localized).","type":"string"}]}
