{"topic":"market_history_output","kind":"structure","description":"Shape of market_history response — OHLC bars with optional volume histogram.","fields":[{"path":"symbol","description":"Contract symbol (echo of input).","type":"string"},{"path":"barType","description":"Bar aggregation type. See describe(topic='barType').","type":"string"},{"path":"barSize","description":"Bar size (minutes for Minute, 1 for Daily, ticks for Tick).","type":"integer"},{"path":"bars[]","description":"One bar per period. Order: oldest → newest.","type":"array"},{"path":"bars[].timestamp","description":"Bar timestamp (ISO-8601) — typically bar start.","type":"string"},{"path":"bars[].open","description":"Open price.","type":"number"},{"path":"bars[].high","description":"High price.","type":"number"},{"path":"bars[].low","description":"Low price.","type":"number"},{"path":"bars[].close","description":"Close price.","type":"number"},{"path":"bars[].upVolume","description":"Volume traded on upticks (buy-initiated).","type":"integer"},{"path":"bars[].downVolume","description":"Volume traded on downticks (sell-initiated).","type":"integer"},{"path":"bars[].upTicks","description":"Number of upticks.","type":"integer"},{"path":"bars[].downTicks","description":"Number of downticks.","type":"integer"},{"path":"bars[].histogram[]","description":"Volume-profile levels. Present only when volumeProfile=true.","type":"array"},{"path":"bars[].histogram[].price","description":"Price level index (multiply by tickSize for price).","type":"integer"},{"path":"bars[].histogram[].bid","description":"Volume traded at this level on the bid side.","type":"integer"},{"path":"bars[].histogram[].offer","description":"Volume traded at this level on the offer side.","type":"integer"},{"path":"dataFeedMode","description":"Timeliness of every bar returned. 'RealTime' when the account holds an active market data subscription or trial for the exchange; 'Delayed' by 10m when it does not.","type":"string"}]}
