{"topic":"market_snapshot_output","kind":"structure","description":"Shape of market_snapshot response — live quote + contract spec for each requested symbol.","fields":[{"path":"snapshots[]","description":"One entry per requested symbol (or per resolved contract when `product` was used).","type":"array"},{"path":"snapshots[].symbol","description":"Contract symbol.","type":"string"},{"path":"snapshots[].productName","description":"Product name (e.g., 'ES').","type":"string"},{"path":"snapshots[].description","description":"Human-readable product description.","type":"string"},{"path":"snapshots[].productType","description":"Product type. See describe(topic='productType').","type":"string"},{"path":"snapshots[].exchange","description":"Exchange code.","type":"string"},{"path":"snapshots[].expirationDate","description":"Contract expiration (yyyy-MM-dd).","type":"string"},{"path":"snapshots[].tickSize","description":"Minimum price increment.","type":"number"},{"path":"snapshots[].tickValue","description":"Monetary value of one tick.","type":"number"},{"path":"snapshots[].valuePerPoint","description":"Monetary value of a 1-point move.","type":"number"},{"path":"snapshots[].initialMargin","description":"Initial margin per contract.","type":"number"},{"path":"snapshots[].maintenanceMargin","description":"Maintenance margin per contract.","type":"number"},{"path":"snapshots[].bidPrice","description":"Best bid (top-of-book).","type":"number"},{"path":"snapshots[].bidSize","description":"Size at bidPrice.","type":"integer"},{"path":"snapshots[].askPrice","description":"Best ask (top-of-book).","type":"number"},{"path":"snapshots[].askSize","description":"Size at askPrice.","type":"integer"},{"path":"snapshots[].lastPrice","description":"Last trade price.","type":"number"},{"path":"snapshots[].openPrice","description":"Session open.","type":"number"},{"path":"snapshots[].highPrice","description":"Session high.","type":"number"},{"path":"snapshots[].lowPrice","description":"Session low.","type":"number"},{"path":"snapshots[].settlementPrice","description":"Prior session settlement.","type":"number"},{"path":"snapshots[].change","description":"lastPrice − settlementPrice (absolute).","type":"number"},{"path":"snapshots[].percentChange","description":"change / settlementPrice × 100.","type":"number"},{"path":"snapshots[].totalVolume","description":"Cumulative session volume.","type":"integer"},{"path":"snapshots[].openInterest","description":"Open interest at last update.","type":"integer"},{"path":"snapshots[].timestamp","description":"Quote timestamp (ISO-8601).","type":"string"},{"path":"snapshots[].dataFeedMode","description":"Timeliness of every quote field in this entry. 'RealTime' when the account holds an active market data subscription or trial for the exchange; 'Delayed' by 10m when it does not. Absent when `error` states that no market data is available.","type":"string"},{"path":"snapshots[].error","description":"Error message when data unavailable for this symbol (contract expired, no feed, no market data subscription, etc.).","type":"string"}]}
