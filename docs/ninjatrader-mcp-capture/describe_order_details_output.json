{"topic":"order_details_output","kind":"structure","description":"Shape of order_details response — full event history and fills for a single order.","fields":[{"path":"items[]","description":"Event rows for the order, ordered chronologically. Combines order-level state events (submit, accept, cancel) with per-fill rows.","type":"array"},{"path":"items[].id","description":"Event identifier (stable across queries).","type":"integer"},{"path":"items[].timestamp","description":"Event timestamp (ISO-8601).","type":"string"},{"path":"items[].ordStatus","description":"Order status at event time. See describe(topic='ordStatus').","type":"string"},{"path":"items[].orderType","description":"Order type. See describe(topic='orderType').","type":"string"},{"path":"items[].action","description":"Buy or Sell. See describe(topic='action').","type":"string"},{"path":"items[].price","description":"Limit/trigger price at event time.","type":"number"},{"path":"items[].stopPrice","description":"Stop price at event time.","type":"number"},{"path":"items[].filledQty","description":"Cumulative filled quantity.","type":"integer"},{"path":"items[].avgFillPrice","description":"VWAP of fills up to this event.","type":"number"},{"path":"items[].notionalValue","description":"Notional value (quantity × price × valuePerPoint).","type":"number"},{"path":"items[].fillTime","description":"Fill timestamp (ISO-8601) — present only on fill events.","type":"string"},{"path":"items[].description","description":"Short event description (e.g., 'Filled', 'Cancelled by user').","type":"string"},{"path":"items[].comments","description":"Additional status text — rejection reason, internal notes.","type":"string"},{"path":"items[].text","description":"Order text or rejection reason (broker-supplied).","type":"string"},{"path":"items[].reason","description":"Rejection reason when applicable.","type":"string"}]}
