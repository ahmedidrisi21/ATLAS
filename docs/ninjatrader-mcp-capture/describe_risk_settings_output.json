{"topic":"risk_settings_output","kind":"structure","description":"Shape of risk_settings and update_risk_settings responses — the per-account risk configuration.","fields":[{"path":"account","description":"Account name.","type":"string"},{"path":"currency","description":"Account base currency.","type":"string"},{"path":"liquidateOnly","description":"True when the account is in liquidate-only mode (cannot open new positions).","type":"boolean"},{"path":"liquidateOnlySince","description":"Timestamp when liq-only mode was entered (ISO-8601).","type":"string"},{"path":"liqOnlyLevel","description":"Equity level below which account enters liq-only.","type":"number"},{"path":"autoLiqLevel","description":"Equity level below which auto-liquidation fires.","type":"number"},{"path":"fullInitialMargin","description":"Full initial margin for the account's open exposure.","type":"number"},{"path":"totalUsedMargin","description":"Current total used margin.","type":"number"},{"path":"maxNetLiq","description":"Highest observed netLiq (anchor for trailing drawdown).","type":"number"},{"path":"maxNetLiqTimestamp","description":"When maxNetLiq was last observed (ISO-8601).","type":"string"},{"path":"trailingMaxDrawdown","description":"Trailing drawdown amount (distance below maxNetLiq).","type":"number"},{"path":"trailingMaxDrawdownLimit","description":"Trailing drawdown floor ($). Breach triggers auto-liq.","type":"number"},{"path":"trailingMaxDrawdownMode","description":"EOD or RealTime. See describe(topic='trailingMaxDrawdownMode').","type":"string"},{"path":"flattenTimestamp","description":"When the account was last flattened (ISO-8601).","type":"string"},{"path":"dailyLossAlert","description":"Daily loss threshold that raises an alert (soft).","type":"number"},{"path":"dailyLossAutoLiq","description":"Daily loss that triggers auto-liquidation (hard).","type":"number"},{"path":"dailyLossLiqOnly","description":"Daily loss that flips account to liq-only.","type":"number"},{"path":"dailyLossPercentageAlert","description":"Percentage-of-equity variant of dailyLossAlert.","type":"number"},{"path":"dailyLossPercentageAutoLiq","description":"Percentage-of-equity variant of dailyLossAutoLiq.","type":"number"},{"path":"dailyLossPercentageLiqOnly","description":"Percentage-of-equity variant of dailyLossLiqOnly.","type":"number"},{"path":"dailyProfitAutoLiq","description":"Daily profit that triggers auto-flatten (profit lock).","type":"number"},{"path":"weeklyLossAutoLiq","description":"Weekly-loss equivalent of dailyLossAutoLiq.","type":"number"},{"path":"weeklyProfitAutoLiq","description":"Weekly-profit equivalent of dailyProfitAutoLiq.","type":"number"},{"path":"marginPercentageAlert","description":"Alert threshold on margin usage (percent).","type":"number"},{"path":"marginPercentageLiqOnly","description":"Margin-usage threshold that flips to liq-only.","type":"number"},{"path":"marginPercentageAutoLiq","description":"Margin-usage threshold that triggers auto-liq.","type":"number"},{"path":"changesLocked","description":"True when the admin has locked risk-setting changes.","type":"boolean"},{"path":"doNotUnlock","description":"Admin flag preventing automatic unlock.","type":"boolean"},{"path":"adminAction","description":"Admin action applied (e.g., lock, unlock).","type":"string"}]}
